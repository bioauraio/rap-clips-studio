# Пароль входа в приложение (один владелец — одна строка)
APP_PASSWORD=change-me
# Ключ подписи сессионной куки
SECRET_KEY=change-me-long-random
# ─────────────── движки картинок и видео (kie.ai) ───────────────
# ОДИН ключ на всё платное: Nano Banana (кадры), Seedance, Kling, MiniMax.
# Берётся на kie.ai → раздел API Keys (kie.ai/api-key), баланс пополняется
# на kie.ai/billing. Пусто = сервис молча работает на подписочных шлюзах
# владельца (ChatGPT/Grok), а /api/providers честно говорит об этом фронту.
KIE_API_KEY=
# Разрешение кадров Nano Banana: 1K | 2K | 4K. 2K — рабочий компромисс:
# нативная вертикаль без ffmpeg-апскейла и вдвое дешевле 4K.
NANO_RESOLUTION=2K
# Порядок движков кадров, если тариф не задал свой (список через запятую,
# например nano-banana-2,chatgpt,grok). Пусто = решает тариф.
IMAGE_PROVIDER_ORDER=
# Сколько ждать задачу kie.ai и как часто опрашивать, секунды.
KIE_TIMEOUT_S=900
KIE_POLL_S=10

# ЗАПАСНЫЕ каналы. Оба дороже kie и заводят второй кошелёк — держим только
# на случай, когда агрегатор лёг.
#   seevio.ai — только Seedance (баланс на 20.08.2026 нулевой):
SEEVIO_API_KEY=
#   официальный klingai.com — только Kling, дороже kie на 17-21 %:
KLING_ACCESS_KEY=
KLING_SECRET_KEY=

# ─────────────────────── экономика очков ───────────────────────
# ЕДИНСТВЕННАЯ константа, связывающая очко с деньгами: сколько СЕБЕСТОИМОСТИ
# мы кладём в одно очко. Цены сцен считаются из неё и из долларовых цен
# движков — трогать только вместе с пересчётом норм тарифов.
POINT_USD=0.0125
# Плата за работу на подписочных шлюзах: нам она стоит ноль, но без ценника
# перерисовка кадров превращается в бесконечный насос по чужой подписке.
GATEWAY_POINTS=2
# Пакеты очков — только при живой платной подписке (0 = продавать всем).
TOPUP_REQUIRES_PLAN=1

# ─────────────────────────── деньги (lolq.ai) ───────────────────────────
# Публичный адрес сервиса: из него собираются return_url оплаты и реф-ссылки.
PUBLIC_BASE_URL=https://lolq.ai
# Имя в чекауте и в выписке по карте.
BRAND_NAME=lolq.ai

# Stripe — доллары (Dashboard → Developers).
#   API keys        → sk_live_… / sk_test_…
#   Webhooks        → эндпоинт https://<домен>/api/billing/stripe-webhook,
#                     события: checkout.session.completed, invoice.paid,
#                     invoice.payment_succeeded, customer.subscription.deleted;
#                     «Signing secret» whsec_… кладётся ниже.
# Объекты Price заводить НЕ нужно: цены уходят в Checkout на лету (price_data).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ЮKassa — рубли (эндпоинт вебхука https://<домен>/api/billing/webhook).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Прайс. Правда — доллары; рубли считаются по курсу USD_RUB (в интернет за
# курсом не ходим). Свой рублёвый ценник: PRICE_PRO_RUB / PRICE_PRO_MAX_RUB /
# PRICE_STUDIO_RUB (и *_YEAR_RUB для годовых) — он победит курс.
PRICE_PRO_USD=20
PRICE_PRO_MAX_USD=100
PRICE_STUDIO_USD=299
USD_RUB=100
YEAR_DISCOUNT_PCT=20

# Партнёрка: скидка приглашённому на первую подписку и доля амбассадора.
REF_DISCOUNT_PCT=10
REF_REWARD_PCT=30
REF_MIN_PAYOUT=1000
